# Admin (/admin). Set these in Vercel → Project → Settings → Environment Variables.
ADMIN_PASSWORD=
# Generate with: openssl rand -base64 48
ADMIN_SESSION_SECRET=

# Where admin saves are committed. Use a fine-grained token limited to this
# repo with "Contents: read and write". On Vercel, GITHUB_REPO is optional and
# defaults to the connected repository.
GITHUB_TOKEN=
GITHUB_REPO=Jim-devENG/my-portfolio
GITHUB_BRANCH=main

# Optional: force saves to "github" or "local" files. Defaults to github in
# production and local in development.
# CONTENT_STORE=
